# Server
PORT=3000

# Supabase Project
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Supabase Database Connection (use %25 to URL-encode % in passwords)
DATABASE_URL=postgresql://postgres.<your-project-ref>:<password>@<host>:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<your-project-ref>:<password>@<host>:5432/postgres

# AI / Third-party Services
GEMINI_API_KEY=<your-google-gemini-api-key>
ELEVENLABS_API_KEY=<your-elevenlabs-api-key>
DEEPL_API_KEY=<your-deepl-api-key>
